generator client {
  provider = "prisma-client"
  // Generated to src/generated/prisma — imported as @/generated/prisma/client
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// MenuItem: items the restaurant can add to a bill (seed data only in v1)
// ---------------------------------------------------------------------------

model MenuItem {
  id         String   @id @default(cuid())
  name       String
  /// Price for one unit, stored as integer in the minor unit (kuruş). 1 TL = 100 kuruş.
  priceKurus Int
  category   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Table: a physical table in the restaurant
// ---------------------------------------------------------------------------

model Table {
  id        String   @id @default(cuid())
  name      String   // "Masa 1", "Teras 2", etc.
  /// Unguessable random token used in QR codes and public URLs (R9).
  /// Never derived from the table name or sequential number.
  token     String   @unique @default(uuid())
  bills     Bill[]
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Bill: one dining session at a table (can be open or closed)
// ---------------------------------------------------------------------------

model Bill {
  id          String     @id @default(cuid())
  tableId     String
  table       Table      @relation(fields: [tableId], references: [id])
  status      BillStatus @default(OPEN)
  mode        SplitMode  @default(NONE)
  /// For EQUAL_SPLIT mode: the number of people sharing the bill.
  splitPeople Int?
  items       BillItem[]
  sessions    Session[]
  payments    Payment[]
  locks       ItemLock[]
  createdAt   DateTime   @default(now())
  closedAt    DateTime?

  @@index([tableId])
}

enum BillStatus {
  OPEN
  CLOSED
}

enum SplitMode {
  NONE
  EQUAL_SPLIT
  BY_ITEM
}

// ---------------------------------------------------------------------------
// BillItem: ONE unit of a menu item on a bill (R6)
// "2x Köfte" → two separate BillItem rows, each individually selectable.
// ---------------------------------------------------------------------------

model BillItem {
  id         String    @id @default(cuid())
  billId     String
  bill       Bill      @relation(fields: [billId], references: [id])
  /// Name copied from MenuItem at time of order — preserves historical prices.
  name       String
  /// Price for this single unit, in minor unit (kuruş).
  priceKurus Int
  isPaid     Boolean   @default(false)
  paymentId  String?
  payment    Payment?  @relation(fields: [paymentId], references: [id])
  lock       ItemLock?
  createdAt  DateTime  @default(now())

  @@index([billId])
  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// Session: an anonymous browser session (R10 — no name, no identity)
// ---------------------------------------------------------------------------

model Session {
  id         String     @id @default(cuid())
  billId     String
  bill       Bill       @relation(fields: [billId], references: [id])
  /// Stored in a browser cookie to re-identify the session across page loads.
  token      String     @unique @default(uuid())
  lastSeenAt DateTime   @default(now())
  locks      ItemLock[]
  payments   Payment[]
  createdAt  DateTime   @default(now())

  @@index([billId])
}

// ---------------------------------------------------------------------------
// Payment: one payment transaction
// R3: bill amount and tip are stored in two separate columns.
// ---------------------------------------------------------------------------

model Payment {
  id                String        @id @default(cuid())
  billId            String
  bill              Bill          @relation(fields: [billId], references: [id])
  sessionId         String?
  session           Session?      @relation(fields: [sessionId], references: [id])
  /// Bill portion paid — integer in minor unit (kuruş).
  amountKurus       Int
  /// Tip — integer in minor unit (kuruş). Stored separately from bill amount (R3).
  tipKurus          Int           @default(0)
  status            PaymentStatus @default(PENDING)
  /// iyzico payment ID, set after server-side verification.
  providerPaymentId String?
  /// iyzico conversationId used during 3DS — enables status lookup.
  conversationId    String?
  /// BillItem units covered by this payment.
  items             BillItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([billId])
  @@index([conversationId])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// ---------------------------------------------------------------------------
// ItemLock: which unit is held by which session (for BY_ITEM split)
// ---------------------------------------------------------------------------

model ItemLock {
  id         String   @id @default(cuid())
  billItemId String   @unique
  billItem   BillItem @relation(fields: [billItemId], references: [id])
  billId     String
  bill       Bill     @relation(fields: [billId], references: [id])
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id])
  isPaid     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([billId])
  @@index([sessionId])
}
