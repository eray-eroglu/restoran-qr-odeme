# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it contains secrets.

# iyzico sandbox credentials (sandbox-merchant.iyzipay.com)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Postgres connection string (neon.tech or supabase.com)
DATABASE_URL=

# Admin panel password (single shared password for v1)
ADMIN_PASSWORD=

# Next.js public base URL (needed for 3D Secure callback URL)
NEXT_PUBLIC_BASE_URL=https://your-project.vercel.app
