# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it contains secrets.

# iyzico sandbox credentials (sandbox-merchant.iyzipay.com)
IYZICO_API_KEY=your-iyzico-api-key
IYZICO_SECRET_KEY=your-iyzico-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Postgres connection string (neon.tech or supabase.com session pooler)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Admin panel password — single shared password for the restaurant staff (v1)
ADMIN_PASSWORD=change-me

# Next.js public base URL (only needed if you override origin detection)
# NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
